# App
APP_NAME=Job Board API
ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# DB
DATABASE_URL=postgresql+psycopg2://jobboard:jobboard@db:5432/jobboard

# Uploads
UPLOAD_DIR=/app/uploads
MAX_RESUME_SIZE_MB=5

# Notifications (stub SMTP - swap for SES/SendGrid in prod)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM_EMAIL=no-reply@jobboard.local
